    given-names: "Yafei"
    orcid: "https://orcid.org/0009-0002-3077-4579"
    affiliation: "School of Atmospheric Sciences, Sun Yat-sen University, and Southern Marine Science and Engineering Guangdong Laboratory (Zhuhai)"
license: Apache-2.0
repository-code: "https://github.com/nieyafei2018/SIToolv2"
url: "https://github.com/nieyafei2018/SIToolv2"
keywords:
  - sea ice
  - model evaluation
  - process-oriented diagnostics
  - CMIP
  - HighResMIP
  - polar climate
  - climate model evaluation
  - Python
